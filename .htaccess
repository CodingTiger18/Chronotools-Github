# =======================================================================
# ChronoTools.online – Hostinger / Apache Server Hardened Configuration
# Cyber Security, AdSense & AI Agent Discovery (WebMCP / llms.txt)
# =======================================================================

Options -Indexes -MultiViews
RewriteEngine On

# 0. Custom 404 Error Document (Enforces Real 404 Status Code)
ErrorDocument 404 /404.html

# 1a. Immediately drop WordPress / PHP vulnerability probes (saves origin CPU/logs)
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|.*\.php)$ - [F,L,NC]

# 1b. Force Single-Hop Non-WWW + HTTPS Canonical Redirect
RewriteCond %{HTTP_HOST} ^www\.chronotools\.online$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://chronotools.online/$1 [L,R=301]

# 2. Redirect Legacy Mixed-Case URLs (Semrush Audit Fix)
RewriteRule ^Docs/Privacy\.html$ /docs/privacy.html [R=301,L,NC]
RewriteRule ^Docs/About\.html$ /docs/about.html [R=301,L,NC]
RewriteRule ^Docs/Contact\.html$ /docs/contact.html [R=301,L,NC]
RewriteRule ^Docs/Terms\.html$ /docs/terms.html [R=301,L,NC]

# 3. Block access to sensitive hidden files, credentials, configs & backups
# Explicitly ALLOW .well-known directory for RFC standards (security.txt, mcp.json, webmcp.json)
<FilesMatch "(^\.env|^\.git|package(-lock)?\.json|tsconfig\.json|vite\.config\.ts|\.lock|\.DS_Store|composer\.json|\.bak|\.tar\.gz)$">
    Require all denied
</FilesMatch>

# 3b. Strictly sandbox internal engineering docs & test harness from web access
RewriteRule ^(internal_docs|internal_tests)(/.*)?$ - [F,L]
<DirectoryMatch "^(internal_docs|internal_tests)">
    Require all denied
</DirectoryMatch>

# 4. Agent-Native Markdown Content Negotiation
# When AI agents (Claude, ChatGPT, Perplexity) request text/markdown on root, serve index.md
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ index.md [L]

<Files "index.md">
    Header set Content-Type "text/markdown; charset=utf-8"
    Header set Vary "Accept"
</Files>

<Files "llms.txt">
    Header set Content-Type "text/markdown; charset=utf-8"
</Files>

# 5. Strict Cyber Security & Agent Discovery Headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Frame options: allow same origin
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Cross-site scripting legacy filter
    Header always set X-XSS-Protection "1; mode=block"
    
    # Strict Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # HSTS (Strict-Transport-Security) for 1 year with subdomains and preload
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Permissions Policy (Restrict camera, mic, payment API)
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=()"
    
    # Content Security Policy (CSP) compatible with Google AdSense, GTM, Sodar & Fonts
    Header always set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://adservice.google.com https://www.googletagservices.com https://partner.googleadservices.com https://www.googletagmanager.com https://*.google-analytics.com https://*.adtrafficquality.google https://ep2.adtrafficquality.google https://*.google.com https://*.doubleclick.net; frame-src 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.googletagmanager.com https://*.google.com https://ep2.adtrafficquality.google; img-src 'self' https: data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://*.google.com https://*.doubleclick.net; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https: https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.adtrafficquality.google https://ep2.adtrafficquality.google https://*.google.com https://*.doubleclick.net;"

    # W3C / AI Content Signals (Singular and Plural for full scanner compatibility)
    Header always set Content-Signal "search=yes, ai-train=no"
    Header always set Content-Signals "search=yes, ai-train=no"

    # RFC 8288 Link Headers for AI Agent Discovery (Strict RFC compliant, clean quotes, zero backslashes)
    Header set Link '</llms.txt>; rel="alternate"; type="text/markdown"'
    Header add Link '</index.md>; rel="alternate"; type="text/markdown"'
    Header add Link '</.well-known/mcp/server-card.json>; rel="mcp-server"'
    Header add Link '</.well-known/webmcp.json>; rel="webmcp-tools"'
</IfModule>

# 6. Gzip / Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/markdown
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 7. Browser Cache Expiration & Revalidation (Prevents Stale Hashed JS 404s)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/markdown "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|md)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(js|css|png|jpg|jpeg|webp|ico|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 8. Block suspicious exploit probes
RewriteCond %{QUERY_STRING} (?:%27|%22|%3C|%3E|%00|<|>|script|base64_decode|eval\(|mosConfig_) [NC,OR]
RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC]
RewriteRule ^ - [F,L]

# 9. Real File & Directory Passthrough
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 10. Single Page Application (SPA) Routing for Valid Routes Only
# Missing pages do NOT get rewritten to index.html; they fall through to return true HTTP 404!
RewriteRule ^(weeks|market-hours|difference|unix|teams|jetlag|tools)/?$ index.html [L]
